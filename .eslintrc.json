{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "prefer-const": "error"
  },
  "languageOptions": {
    "globals": {
      "AbortController": "readonly",
      "AbortSignal": "readonly"
    }
  }
}